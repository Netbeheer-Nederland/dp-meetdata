cim:IOPoint a sh:NodeShape ;
    sh:closed false ;
    sh:description "The class describe a measurement or control value. The purpose is to enable having attributes and associations common for measurement and control." ;
    sh:ignoredProperties ( cim:IntervalReading.IntervalBlocks cim:BaseReading.value cim:MeasurementValue.timeStamp rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """The name is any free human readable and possibly non unique text naming the object.\r
""" ;
