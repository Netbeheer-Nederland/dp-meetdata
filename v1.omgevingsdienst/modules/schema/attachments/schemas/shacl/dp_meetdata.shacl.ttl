            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path nl:IdentifiedObject.europeanArticleNumberEAN ] ;
    sh:targetClass cim:MarketEvaluationPoint .

cim:Location a sh:NodeShape ;
    sh:closed false ;
    sh:description """The place, scene, or point of something where someone or something has been, is, and/or will be at a given moment in time. It can be defined with one or more position points (coordinates) in a given coordinate system.\r
""" ;
